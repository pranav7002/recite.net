# Google Gemini API — all models. Key: https://aistudio.google.com/apikey
# Use a project with billing turned OFF (free tier).
GEMINI_API_KEY=

# ---- Chat ----
ANSWER_MODEL=
CHECK_MODEL=
# Per-model limits — fill in from your AI Studio rate-limit page.
ANSWER_MODEL_RPM=
ANSWER_MODEL_RPD=
CHECK_MODEL_RPM=
CHECK_MODEL_RPD=

# ---- Embedding ----
EMBEDDING_MODEL=
# From your AI Studio rate-limit page: per-minute limit and batch size.
EMBED_DIMENSIONS=
EMBED_BATCH_SIZE=
EMBED_RPM=
EMBED_RPD=
# tiktoken vocab lives here (downloaded once; no network needed at runtime)
TIKTOKEN_CACHE_DIR=

# ---- Store (PostgreSQL + pgvector) ----
DATABASE_URL=

# ---- Guardrails ----
# Study-group recipients for email_summary (comma-separated). Empty = all sends blocked.
CONTACTS=

# ---- Router ----
# Tuned on the tune split (see EXPERIMENTS.md): observed top cosine scores
# 0.70-0.79 and section counts 2-5. 0.5 never fired; sections>=4 fired 70% of
# the time because per-page chunks make every slide its own "section".
SCORE_THRESHOLD=
SCATTER_SECTIONS=

# ---- Speech ----
STT_MODEL=
TTS_MODEL=
TTS_VOICE=                      # verified working with the TTS model; override to change the voice
# Per-model limits — verify on your AI Studio rate-limit page.
TTS_RPM=
TTS_RPD=
STT_RPM=
STT_RPD=
REALTIME_MODEL=

# ---- RLM arm ----
# gemini-3.1-flash-lite (the answer model, 500/day) never finishes the rlms
# code-execution loop; gemma-4-26b-a4b-it has 14,400/day and did, once its
# <thought> leakage is stripped (see EXPERIMENTS.md). ~5/min is the practical
# cap from its 16K-tokens-per-minute limit, not the stated 30 RPM.
RLM_MODEL=
RLM_MODEL_RPM=
RLM_MODEL_RPD=
